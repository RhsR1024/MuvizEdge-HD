<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:padding="15.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@id/show_notify_lt" style="@style/settingsParent">
            <LinearLayout style="@style/settingsTextGroup">
                <TextView android:text="@string/show_notifications_label" style="@style/settingsText" />
                <TextView android:textColor="@color/warning" android:id="@id/show_notify_subtext" android:text="@string/notification_access_label" style="@style/settingsSubText" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@id/show_notify_switch" style="@style/settingsAction" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@id/notify_preview_lt" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <View style="@style/settingsSeparator" />
            <LinearLayout style="@style/settingsParent">
                <LinearLayout style="@style/settingsTextGroup">
                    <TextView android:text="@string/notify_preview_label" style="@style/settingsText" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@id/notif_preview_switch" style="@style/settingsAction" />
            </LinearLayout>
        </LinearLayout>
        <View style="@style/settingsSeparator" />
    </LinearLayout>
</ScrollView>
